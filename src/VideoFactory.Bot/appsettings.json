{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Telegram": {
    "BotToken": "",
    "AllowedUserId": 0,
    "ProgressMessageIntervalSeconds": 5
  },
  "Paths": {
    "WorkspaceRoot": "../.."
  },
  "Storage": {
    "DataRoot": "data",
    "DatabaseFileName": "jobs.sqlite",
    "MinimumFreeBytes": 1073741824,
    "JobQuotaBytes": 5368709120,
    "CompletedJobRetentionDays": 30
  },
  "Limits": {
    "MaxInputFileBytes": 524288000,
    "MaxInputDurationSeconds": 1800
  },
  "Worker": {
    "HeartbeatIntervalSeconds": 10,
    "LeaseTimeoutSeconds": 60,
    "MaxStageAttempts": 3,
    "PollIntervalSeconds": 5
  },
  "FFmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  },
  "Whisper": {
    "PythonPath": "python",
    "WorkerPath": "scripts/whisper-worker.py"
  },
  "Remotion": {
    "NodePath": "node",
    "RenderHostPath": "render-host/dist/cli.js"
  },
  "AudioNormalization": {
    "SampleRate": 48000,
    "ChannelLayout": "stereo",
    "LoudnessLufs": -16,
    "TruePeakDbtp": -1
  },
  "OutputQuality": {
    "ExpectedWidth": 1080,
    "ExpectedHeight": 1920,
    "ExpectedFrameRateNumerator": 30,
    "ExpectedFrameRateDenominator": 1,
    "ExpectedPixelFormat": "yuv420p",
    "DurationToleranceFrames": 3,
    "RequireAudio": true,
    "MaxTelegramBytes": 50000000,
    "VideoBitrateBitsPerSecond": 4000000,
    "AudioBitrateBitsPerSecond": 128000,
    "ContainerReserveBytes": 2097152,
    "MaxDeliveryEncodeAttempts": 1,
    "DeliveryEncodeVideoBitrateBitsPerSecond": 3500000,
    "DeliveryEncodeAudioBitrateBitsPerSecond": 96000
  },
  "ProcessTimeouts": {
    "ProbeSeconds": 30,
    "DecodeSeconds": 300,
    "NormalizeSeconds": 600,
    "RenderSeconds": 1800,
    "MaxOutputBytes": 65536
  },
  "Planning": {
    "JobLimitUsd": 0.05
  },
  "Critic": {
    "MaxRemounts": 2,
    "BlackMinimumDurationMilliseconds": 200,
    "FreezeMinimumDurationMilliseconds": 1000
  },
  "AiApi": {
    "Provider": "",
    "ApiKey": "",
    "Model": ""
  }
}
