{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Telegram": {
    "BotToken": "",
    "AllowedUserId": 0
  },
  "Paths": {
    "WorkspaceRoot": "../.."
  },
  "Storage": {
    "DataRoot": "data",
    "DatabaseFileName": "jobs.sqlite"
  },
  "Limits": {
    "MaxInputFileBytes": 524288000,
    "MaxInputDurationSeconds": 1800
  },
  "Worker": {
    "HeartbeatIntervalSeconds": 10,
    "LeaseTimeoutSeconds": 60,
    "MaxStageAttempts": 3,
    "PollIntervalSeconds": 5
  },
  "FFmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe"
  },
  "Whisper": {
    "PythonPath": "python",
    "WorkerPath": "scripts/whisper-worker.py"
  },
  "Remotion": {
    "NodePath": "node",
    "RenderHostPath": "render-host/dist/index.js"
  },
  "ProcessTimeouts": {
    "ProbeSeconds": 30,
    "DecodeSeconds": 300,
    "NormalizeSeconds": 600,
    "RenderSeconds": 1800,
    "MaxOutputBytes": 65536
  },
  "AiApi": {
    "Provider": "",
    "ApiKey": "",
    "Model": ""
  }
}
