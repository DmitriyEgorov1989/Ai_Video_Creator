# Copy this file to .env and replace placeholders locally.
# Never commit .env or put real secrets in this example.
Telegram__BotToken=
Telegram__AllowedUserId=
AiApi__Provider=deepseek
AiApi__ApiKey=
AiApi__Model=deepseek-chat

# WHISPER_MODEL_PATH is read by the Python child process and must be exported
# in the PowerShell session that starts the acceptance runner.
