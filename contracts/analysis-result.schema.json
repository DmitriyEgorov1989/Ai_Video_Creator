{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-factory.local/contracts/analysis-result.schema.json",
  "title": "AnalysisResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "RevisionId", "OriginalAssetId", "MasterAssetId", "Speech", "Pauses", "Scenes", "AllowedSegments"],
  "properties": {
    "SchemaVersion": { "enum": [1, 2] },
    "RevisionId": { "type": "string", "minLength": 1 },
    "OriginalAssetId": { "type": "string", "minLength": 1 },
    "MasterAssetId": { "type": "string", "minLength": 1 },
    "Speech": { "type": "array", "items": { "$ref": "#/$defs/speech" } },
    "Pauses": { "type": "array", "items": { "$ref": "#/$defs/range" } },
    "Scenes": { "type": "array", "items": { "type": "object", "required": ["Interval"], "additionalProperties": false, "properties": { "Interval": { "$ref": "#/$defs/range" } } } },
    "AllowedSegments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "Features": { "$ref": "#/$defs/analysisFeatures" }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": ["StartMicroseconds", "EndMicroseconds"],
      "additionalProperties": false,
      "properties": {
        "StartMicroseconds": { "type": "integer", "minimum": 0 },
        "EndMicroseconds": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "word": {
      "type": "object",
      "required": ["Text", "Interval"],
      "additionalProperties": false,
      "properties": { "Text": { "type": "string", "minLength": 1 }, "Interval": { "$ref": "#/$defs/range" } }
    },
    "speech": {
      "type": "object",
      "required": ["Text", "Interval", "Words"],
      "additionalProperties": false,
      "properties": {
        "Text": { "type": "string", "minLength": 1 },
        "Interval": { "$ref": "#/$defs/range" },
        "Words": { "type": "array", "items": { "$ref": "#/$defs/word" } },
        "SegmentId": { "type": ["string", "null"] }
      }
    },
    "features": {
      "type": "object",
      "required": ["Motion", "Sharpness", "Exposure", "AudioEnergy", "TechnicalValidity", "TechnicalIssues"],
      "additionalProperties": false,
      "properties": {
        "Motion": { "type": "number", "minimum": 0, "maximum": 1 },
        "Sharpness": { "type": "number", "minimum": 0, "maximum": 1 },
        "Exposure": { "type": "number", "minimum": 0, "maximum": 1 },
        "AudioEnergy": { "type": "number", "minimum": 0, "maximum": 1 },
        "TechnicalValidity": { "type": "boolean" },
        "TechnicalIssues": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "segmentAnalysis": {
      "type": "object",
      "required": ["SegmentId", "SemanticRelevance", "Sharpness", "Composition", "Motion", "AudioEnergy", "Confidence"],
      "additionalProperties": false,
      "properties": {
        "SegmentId": { "type": "string", "minLength": 1 },
        "SemanticRelevance": { "type": "number", "minimum": 0, "maximum": 1 },
        "Sharpness": { "type": "number", "minimum": 0, "maximum": 1 },
        "Composition": { "type": "number", "minimum": 0, "maximum": 1 },
        "Motion": { "type": "number", "minimum": 0, "maximum": 1 },
        "AudioEnergy": { "type": "number", "minimum": 0, "maximum": 1 },
        "Confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "DuplicateGroup": { "type": ["string", "null"] }
      }
    },
    "focalObservation": {
      "type": "object",
      "required": ["SegmentId", "MasterTimeMicroseconds", "X", "Y", "Width", "Height", "Confidence"],
      "additionalProperties": false,
      "properties": {
        "SegmentId": { "type": "string", "minLength": 1 },
        "MasterTimeMicroseconds": { "type": "integer", "minimum": 0 },
        "X": { "type": "number", "minimum": 0, "maximum": 1 },
        "Y": { "type": "number", "minimum": 0, "maximum": 1 },
        "Width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "Height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "Confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "analysisFeatures": {
      "type": "object",
      "required": ["SchemaVersion", "Segments"],
      "additionalProperties": false,
      "properties": {
        "SchemaVersion": { "const": 1 },
        "Segments": { "type": "array", "items": { "$ref": "#/$defs/segmentAnalysis" } },
        "FocalObservations": { "type": "array", "items": { "$ref": "#/$defs/focalObservation" } }
      }
    },
    "segment": {
      "type": "object",
      "required": ["Id", "Mapping"],
      "additionalProperties": false,
      "properties": {
        "Id": { "type": "string", "minLength": 1 },
        "Mapping": { "type": "object", "required": ["OriginalAssetId", "Original", "MasterAssetId", "Master"], "additionalProperties": false, "properties": { "OriginalAssetId": { "type": "string" }, "Original": { "$ref": "#/$defs/range" }, "MasterAssetId": { "type": "string" }, "Master": { "$ref": "#/$defs/range" } } },
        "SpeechSegmentIds": { "type": "array", "items": { "type": "string" } },
        "SceneIndexes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "Features": { "$ref": "#/$defs/features" },
        "Confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "Reasons": { "type": "array", "items": { "type": "string" } },
        "IsApproved": { "type": "boolean" }
      }
    }
  }
}
