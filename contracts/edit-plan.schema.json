{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-factory.local/contracts/edit-plan.schema.json",
  "title": "EditPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "variantId", "revisionId", "analysisRevisionId", "seed", "output", "template", "templateProps", "video", "audio", "captions", "overlays"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "variantId": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "string", "minLength": 1 },
    "analysisRevisionId": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "frameRate", "durationFrames"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "frameRate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "type": "integer", "minimum": 1 }
          }
        },
        "durationFrames": { "type": "integer", "minimum": 1 }
      }
    },
    "template": { "const": "dynamic" },
    "templateProps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captions", "theme"],
      "properties": {
        "captions": { "enum": ["none", "minimal", "emphasis"] },
        "theme": { "enum": ["light", "dark"] },
        "title": { "type": ["string", "null"] }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clips"],
      "properties": {
        "clips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/videoClip" } }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClips", "musicClips"],
      "properties": {
        "sourceClips": { "type": "array", "items": { "$ref": "#/$defs/sourceAudioClip" } },
        "musicClips": { "type": "array", "maxItems": 0 }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/caption" } } }
    },
    "overlays": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/overlay" } } }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startFrame", "endFrame"],
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 1 }
      }
    },
    "videoClip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segmentId", "mapping", "output", "crop"],
      "properties": {
        "segmentId": { "type": "string", "minLength": 1 },
        "mapping": { "type": "object" },
        "output": { "$ref": "#/$defs/range" },
        "crop": { "enum": ["fit", "centerCrop"] }
      }
    },
    "sourceAudioClip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segmentId", "output", "gain"],
      "properties": {
        "segmentId": { "type": "string", "minLength": 1 },
        "output": { "$ref": "#/$defs/range" },
        "gain": { "type": "number", "minimum": 0 }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "output"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "output": { "$ref": "#/$defs/range" }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "output"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "minLength": 1 },
        "output": { "$ref": "#/$defs/range" }
      }
    }
  }
}
