{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-factory.local/contracts/render-request.schema.json",
  "title": "RenderRequest",
  "oneOf": [
    { "$ref": "#/$defs/v1" },
    { "$ref": "#/$defs/v2" }
  ],
  "$defs": {
    "baseProperties": {
      "jobId": { "type": "string", "minLength": 1 },
      "variantId": { "type": "string", "minLength": 1 },
      "outputPath": { "type": "string", "minLength": 1 },
      "encoding": { "type": "object", "additionalProperties": false, "required": ["videoBitrateBitsPerSecond", "audioBitrateBitsPerSecond"], "properties": { "videoBitrateBitsPerSecond": { "type": "integer", "minimum": 1 }, "audioBitrateBitsPerSecond": { "type": "integer", "minimum": 1 } } }
    },
    "frameRate": { "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": { "numerator": { "type": "integer", "minimum": 1 }, "denominator": { "type": "integer", "minimum": 1 } } },
    "v1": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "jobId", "variantId", "plan", "assets", "outputPath", "encoding"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "jobId": { "$ref": "#/$defs/baseProperties/jobId" }, "variantId": { "$ref": "#/$defs/baseProperties/variantId" }, "outputPath": { "$ref": "#/$defs/baseProperties/outputPath" }, "encoding": { "$ref": "#/$defs/baseProperties/encoding" },
        "plan": { "oneOf": [{ "$ref": "edit-plan.schema.json" }, { "$ref": "edit-plan.v2.schema.json" }] },
        "assets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "frameRate": { "oneOf": [{ "$ref": "#/$defs/frameRate" }, { "type": "null" }] } } } }
      }
    },
    "v2": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "jobId", "variantId", "plan", "assets", "outputPath", "encoding"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "jobId": { "$ref": "#/$defs/baseProperties/jobId" }, "variantId": { "$ref": "#/$defs/baseProperties/variantId" }, "outputPath": { "$ref": "#/$defs/baseProperties/outputPath" }, "encoding": { "$ref": "#/$defs/baseProperties/encoding" },
        "plan": { "$ref": "edit-plan.v3.schema.json" },
        "assets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["sourceAssetId", "videoPath", "frameRate"], "properties": { "sourceAssetId": { "type": "string", "minLength": 1 }, "videoPath": { "type": "string", "minLength": 1 }, "audioPath": { "type": ["string", "null"] }, "frameRate": { "$ref": "#/$defs/frameRate" } } } }
      }
    }
  }
}
